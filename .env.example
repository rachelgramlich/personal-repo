# Notion integration — create at https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...

# Recipes database ID (from database URL)
NOTION_DATABASE_ID=82684e8b-6766-418e-9fcf-baf17a462266

# Optional: default number of meals for weekly planning
GROCERY_WIZARD_DEFAULT_MEALS=7

# Optional: override Notion column names when they differ from defaults
# GROCERY_WIZARD_NAME_COLUMN=Name
# GROCERY_WIZARD_LINK_COLUMN=Link
# GROCERY_WIZARD_INGREDIENTS_COLUMN=Ingredients

# Optional: Notion data source ID (auto-detected when omitted)
# NOTION_DATA_SOURCE_ID=...

# Optional: NYT Cooking credentials (required for `nyt saved` and `nyt sync`)
# Copy NYT-S and regi_id from browser DevTools — see README
# NYT_S_COOKIE=...
# NYT_REGI_ID=...
# NYT_USER_ID=...  # alias for NYT_REGI_ID

# Optional: Notion checkbox column for NYT batch imports (default: Synced from NYT recipe box)
# GROCERY_WIZARD_NYT_SYNCED_COLUMN=Synced from NYT recipe box
