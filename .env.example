# Notion integration — create at https://www.notion.so/my-integrations
NOTION_API_KEY=<insert_notion_integration_secret>

# Database IDs (32-char id from each database URL path /p/…, with dashes)
NOTION_RECIPE_DATABASE_ID=<insert_recipes_database_id>
NOTION_PANTRY_DATABASE_ID=<insert_pantry_database_id>
NOTION_RECURRING_WEEKLY_DATABASE_ID=<insert_recurring_weekly_database_id>
NOTION_WEEKLY_MEAL_PLANS_DATABASE_ID=<insert_weekly_meal_plans_database_id>

# Optional: default number of meals for weekly planning
GROCERY_WIZARD_DEFAULT_MEALS=5

# NYT Cooking (DevTools cookies — see src/grocery_wizard/README.md)
NYT_S_COOKIE=<insert_nyt_s_cookie>
NYT_REGI_ID=<insert_nyt_regi_id>
